# ── Core ──
DATABASE_URL="postgresql://user:password@localhost:5432/gymtrackey"
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Platform super admin (used only by `npm run db:seed`; never hard-code credentials) ──
# One-time browser setup at /setup (12+ chars). Remove after the admin is created.
SETUP_TOKEN=""
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# ── Daily automation (Vercel Cron sends this as a Bearer token) ──
CRON_SECRET=""

# ── Razorpay (SaaS subscription billing) ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Email / messaging ──
EMAIL_SERVER=""
EMAIL_FROM="GymTrackey <no-reply@gymtrackey.com>"
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_ID=""
SMS_API_KEY=""

# ── S3-compatible object storage ──
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
